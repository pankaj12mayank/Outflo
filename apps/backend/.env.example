# Core
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (MongoDB)
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=outflo

# ===========================================
# SYSTEM OWNER CONFIGURATION
# ===========================================
# Default credentials - CHANGE IN PRODUCTION!
SYSTEM_OWNER_EMAIL=admin@outflo.com
SYSTEM_OWNER_PASSWORD=Admin@123
SYSTEM_OWNER_JWT_SECRET=CHANGE_THIS_IN_PRODUCTION

# Temporary password assigned to invited team members - CHANGE IN PRODUCTION!
TEAM_MEMBER_DEFAULT_PASSWORD=Test@1234

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# AI (OpenAI / Anthropic / custom OpenAI-compatible)
AI_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_TIMEOUT=120
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Playwright
PLAYWRIGHT_BROWSERS_PATH=./browsers
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Scraping
SCRAPE_DELAY_MS=2000
SCRAPE_MAX_CONCURRENT=5
SCRAPE_RETRY_ATTEMPTS=3

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Storage
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE_MB=10
